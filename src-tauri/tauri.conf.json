{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zpace",
  "version": "0.1.5",
  "identifier": "dev.conduit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Zpace",
        "width": 1360,
        "height": 880,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "shadow": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A desktop workspace for Claude Code and other CLI agents.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMTI4MDlCRUUxODk2N0YKUldSL2xoanVtNEFTTUEwajE3cU1TQ3FSZlV6cXBoYlVKdFRsdmhVQ3Z0OE83ZGFTS1lzUDNKUnQK",
      "endpoints": [
        "https://github.com/Nicoo01x/Zpace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
